model ClassTeacherTenure {
    id             String              @id @default(uuid())
    academicYearId String
    sectionTenureId String
    teacherId      String
    status         TENURE_STATUS       @default(ACTIVE)
    
    academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    sectionTenure  SectionTenure       @relation("ClassTeacherTenure", fields: [sectionTenureId], references: [id], onDelete: Cascade)
    teacher        User                @relation("ClassTeacherTenure", fields: [teacherId], references: [id], onDelete: Cascade)
    
    @@unique([academicYearId, sectionTenureId])
    @@unique([sectionTenureId])
    @@index([academicYearId, teacherId])
}
