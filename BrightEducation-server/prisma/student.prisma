model Student {
    id String @id @default(uuid())

    userId String @unique

    admissionNo   String   @unique
    admissionDate DateTime
    rollNumber    String?
    classGrade    String?
    section       String?
    academicYearId String?
    prevSchool     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    fees StudentFee[]
}
