model StudentEnrollment {
    id             String              @id @default(uuid())
    studentId      String
    academicYearId String
    sectionTenureId String
    rollNumber     String?
    status         ENROLLMENT_STATUS   @default(ACTIVE)
    
    academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
    student        User                @relation("StudentEnrollment", fields: [studentId], references: [id], onDelete: Cascade)
    sectionTenure  SectionTenure       @relation(fields: [sectionTenureId], references: [id], onDelete: Cascade)
    
    @@unique([studentId, academicYearId])
    @@index([academicYearId, status])
}
