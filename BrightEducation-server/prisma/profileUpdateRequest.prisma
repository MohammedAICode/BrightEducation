model ProfileUpdateRequest {
    id String @id @default(uuid())

    // User whose profile is being updated
    userId String
    user   User   @relation("ProfileUpdateRequester", fields: [userId], references: [id], onDelete: Cascade)

    // User who initiated the request (for management-initiated updates)
    requesterId String?
    requester   User?   @relation("ProfileUpdateRequestInitiator", fields: [requesterId], references: [id], onDelete: SetNull)

    // Reason for the update request (mandatory for management-initiated requests)
    reason String?

    // Fields that can be updated (all optional, only changed fields will be included)
    firstname                String?
    lastname                 String?
    gender                   Gender?
    dateOfBirth              DateTime?
    phone                    String?
    address                  String?
    emergencyContactRelation String?
    emergencyContact         String?
    bloodGroup               String?
    nationality              String?
    religion                 String?
    parentRelation           String?
    parentName               String?
    parentPhone              String?
    parentOccupation         String?
    profileImgKey            String?

    // Approval status
    status REQUEST_STATUS @default(PENDING)

    // Admin who approved/rejected
    approvedById String?
    approvedBy   User?      @relation("ProfileUpdateApprover", fields: [approvedById], references: [id], onDelete: SetNull)

    // Rejection reason
    rejectionReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([status])
    @@index([requesterId])
}

enum REQUEST_STATUS {
    PENDING
    APPROVED
    REJECTED
}
